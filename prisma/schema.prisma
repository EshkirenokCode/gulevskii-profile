generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Link {
  profileId String
  key       String
  position  Int
  label     String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
}

model Skill {
  profileId String
  key       String
  position  Int
  name      String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
}

model Experience {
  profileId    String
  key          String
  company      String
  position     String
  startMonth   String   @db.Char(7)
  endMonth     String?  @db.Char(7)
  achievements String[]
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
}

model Project {
  profileId String
  key       String
  position  Int
  name      String
  url       String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
}
